# Copy to .env.local and fill in. Never commit real values.
# Local Supabase values come from `npx supabase status -o env` after `npm run db:start`.

# Supabase — public (safe for the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only (bypasses row-level security)
SUPABASE_SECRET_KEY=

# Public URL of the app (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Anthropic (console.anthropic.com → API Keys). Without a key the assistant is switched off.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Optional: low | medium | high (defaults to low)
ANTHROPIC_EFFORT=

# Voyage AI embeddings (dashboard.voyageai.com → API keys). Needed to index documents and to search.
VOYAGE_API_KEY=

# Password of the demo company's fixed accounts. Local databases use a fixed one when empty.
DEMO_USER_PASSWORD=
# Shared secret for the scheduled clean-up endpoint (Vercel cron sends it).
CRON_SECRET=
